/ نمونه‌ی کارگر و کانال (fan-out / fan-in)
jobs = کانال(صحیح)
نتایج = کانال(صحیح و ۶)
انجام = کانال(بولی)

تعریف کارگر():
	برای کار در jobs:
		نتایج << کار × ۲
	انجام << درست

تعریف ارسال():
	برای ای از ۱ تا ۷:
		jobs << ای
	jobs ببند

برو ارسال()
برای ای از ۰ تا ۳:
	برو کارگر()

/ صبر برای پایان ۳ کارگر
برای ای از ۰ تا ۳:
	>>انجام

/ جمع‌آوری نتایج: هر یک از ۶ کار دقیقاً یک‌بار دوبله شده
مجموع = ۰
برای ای از ۰ تا ۶:
	مقدار = >>نتایج
	مجموع = مجموع + مقدار
مجموع بنویس